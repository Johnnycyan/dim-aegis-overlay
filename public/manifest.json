{
  "manifest_version": 3,
  "name": "DIM Aegis Overlay",
  "version": "1.2.0",
  "description": "Display Aegis wishlist rankings directly inside Destiny Item Manager (DIM).",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://app.destinyitemmanager.com/*",
    "https://beta.destinyitemmanager.com/*",
    "https://www.light.gg/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.destinyitemmanager.com/*",
        "https://beta.destinyitemmanager.com/*"
      ],
      "js": [
        "main-world-content.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.destinyitemmanager.com/*",
        "https://beta.destinyitemmanager.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.light.gg/*"
      ],
      "js": [
        "lightgg-main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.light.gg/god-roll/roll-appraiser/",
        "https://www.light.gg/god-roll/roll-appraiser/*"
      ],
      "js": [
        "lightgg-content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dim-aegis-overlay@maxeption.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
